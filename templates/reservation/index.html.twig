{% extends 'base.html.twig' %}

{% block title %}Mes réservations{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mes réservations</h1>
        <a href="{{ path('app_reservation_new') }}" class="btn btn-primary">+ Nouvelle réservation</a>
    </div>
    
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Salle</th>
                <th>Date début</th>
                <th>Date fin</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.room.name }}</td>
                <td>{{ reservation.startDate|date('d/m/Y H:i') }}</td>
                <td>{{ reservation.endDate|date('d/m/Y H:i') }}</td>
                <td>
                    {% if reservation.startDate > date() %}
                        <span class="badge bg-success">À venir</span>
                    {% elseif reservation.endDate < date() %}
                        <span class="badge bg-secondary">Terminée</span>
                    {% else %}
                        <span class="badge bg-warning">En cours</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    <form method="post" action="{{ path('app_reservation_delete', {'id': reservation.id}) }}" style="display: inline-block;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
                        <button class="btn btn-sm btn-danger" onclick="return confirm('Annuler cette réservation ?')">Annuler</button>
                    </form>
                </td>
            </tr>
            {% else %}
            35row
                <td colspan="5" class="text-center">Aucune réservation trouvée</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
