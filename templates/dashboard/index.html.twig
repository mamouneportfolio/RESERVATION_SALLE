{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Tableau de bord</h1>
    
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">Total des salles</div>
                <div class="card-body">
                    <h5 class="card-title">{{ total_rooms }}</h5>
                    <p class="card-text">salles disponibles</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">Total des réservations</div>
                <div class="card-body">
                    <h5 class="card-title">{{ total_reservations }}</h5>
                    <p class="card-text">réservations au total</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card text-white bg-info mb-3">
                <div class="card-header">Réservations du jour</div>
                <div class="card-body">
                    <h5 class="card-title">{{ today_reservations|length }}</h5>
                    <p class="card-text">pour aujourd'hui</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-4">
        <h2>Réservations du jour</h2>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Salle</th>
                    <th>Utilisateur</th>
                    <th>Début</th>
                    <th>Fin</th>
                </tr>
            </thead>
            <tbody>
                {% for reservation in today_reservations %}
                <tr>
                    <td>{{ reservation.room.name }}</td>
                    <td>{{ reservation.user.email }}</td>
                    <td>{{ reservation.startDate|date('H:i') }}</td>
                    <td>{{ reservation.endDate|date('H:i') }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4">Aucune réservation pour aujourd'hui</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
