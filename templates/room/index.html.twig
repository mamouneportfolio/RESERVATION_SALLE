{% extends 'base.html.twig' %}

{% block title %}Gestion des salles{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des salles</h1>
        <a href="{{ path('app_room_new') }}" class="btn btn-primary">+ Ajouter une salle</a>
    </div>
    
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Capacité</th>
                <th>Étage</th>
                <th>Équipements</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for room in rooms %}
            <tr>
                <td>{{ room.name }}</td>
                <td>{{ room.capacity }} personnes</td>
                <td>{{ room.floor }}e étage</td>
                <td>
                    {% if room.equipment %}
                        {{ room.equipment|join(', ') }}
                    {% else %}
                        -
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_room_show', {'id': room.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_room_edit', {'id': room.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    <form method="post" action="{{ path('app_room_delete', {'id': room.id}) }}" style="display: inline-block;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ room.id) }}">
                        <button class="btn btn-sm btn-danger" onclick="return confirm('Supprimer cette salle ?')">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="text-center">Aucune salle trouvée</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
